{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boring:spec.schema.json",
  "title": "Boring spec file (specs/**/spec.yaml)",
  "type": "object",
  "required": ["schema_version", "spec"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "required": [
        "id", "title", "domain", "summary", "version", "status", "updated",
        "applies_when", "does_not_apply_when", "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "status": { "$ref": "#/$defs/status" },
        "updated": { "$ref": "#/$defs/date" },
        "applies_when": { "type": "array", "items": { "type": "string" } },
        "does_not_apply_when": { "type": "array", "items": { "type": "string" } },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id", "title", "level", "status", "statement", "why", "applies_when",
        "sources", "evidence", "verification", "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^BORING-(?!EDGE-)(?:[A-Z0-9]+-)+[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "level": { "enum": ["MUST", "SHOULD", "CONSIDER"] },
        "status": { "$ref": "#/$defs/status" },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "The normative requirement in one or two sentences."
        },
        "why": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "applies_when": { "type": "array", "items": { "type": "string" } },
        "does_not_apply_when": { "type": "array", "items": { "type": "string" } },
        "exceptions": { "type": "array", "items": { "type": "string" } },
        "failure_modes": { "type": "array", "items": { "type": "string" } },
        "decision_required": {
          "type": "boolean",
          "default": false,
          "description": "True when the requirement is to define and enforce a policy, not a specific universal choice."
        },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source-ref" } },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "edge_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge-ref" }
        },
        "related_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule-ref" }
        },
        "superseded_by": { "$ref": "#/$defs/rule-ref" },
        "verification": { "$ref": "#/$defs/verification" },
        "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "verification": {
      "type": "object",
      "required": ["automatable", "scenarios"],
      "additionalProperties": false,
      "properties": {
        "automatable": { "enum": [true, "partial", false] },
        "visibility": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["black-box", "source-review", "configuration", "infrastructure", "manual"] }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenario" }
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["given", "when", "expect"],
      "additionalProperties": false,
      "properties": {
        "given": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }] },
        "when": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }] },
        "expect": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "status": { "enum": ["draft", "reviewed", "stable", "deprecated"] },
    "evidence": {
      "type": "object",
      "required": ["source", "locator", "support", "note"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/source-ref" },
        "locator": { "type": "string", "minLength": 1 },
        "support": { "enum": ["direct", "derived", "contextual"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source-ref": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+(-[A-Z0-9]+)*$" },
    "edge-ref": { "type": "string", "pattern": "^BORING-EDGE-(?:[A-Z0-9]+-)+[0-9]{3}$" },
    "rule-ref": { "type": "string", "pattern": "^BORING-(?!EDGE-)(?:[A-Z0-9]+-)+[0-9]{3}$" }
  }
}
