{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boring:edge-case.schema.json",
  "title": "Boring edge-case dataset (edge-cases/**/*.yaml)",
  "type": "object",
  "required": ["dataset", "cases"],
  "additionalProperties": false,
  "properties": {
    "dataset": { "$ref": "#/$defs/dataset" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "required": ["id", "title", "description", "updated"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "updated": { "$ref": "#/$defs/date" }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "title", "kind", "risk", "scenario", "sources", "tags"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^BORING-EDGE-(?:[A-Z0-9]+-)+[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": [
          "value", "boundary", "state", "sequence", "retry",
          "concurrency", "locale", "environment", "authorization"
        ] },
        "risk": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": [
            "security", "correctness", "data-integrity", "privacy",
            "availability", "performance", "ux", "compliance"
          ] }
        },
        "input": {
          "type": "array",
          "description": "Concrete example inputs, for value and boundary cases.",
          "items": {
            "type": "object",
            "required": ["description", "value"],
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "value": { "type": ["string", "number", "boolean", "null"] }
            }
          }
        },
        "scenario": { "$ref": "#/$defs/scenario" },
        "decision_required": { "type": "boolean", "default": false },
        "examples": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source-ref" } },
        "related_rules": {
          "type": "array",
          "items": { "type": "string", "pattern": "^BORING-[A-Z0-9]+(-[A-Z0-9]+)*$" }
        },
        "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["given", "when", "expect"],
      "additionalProperties": false,
      "properties": {
        "given": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "expect": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source-ref": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+(-[A-Z0-9]+)*$" }
  }
}
