{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boring:source.schema.json",
  "title": "Boring source registry (sources/registry.yaml)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "title", "organization", "type", "tier", "url", "topics", "accessed", "notes"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+(-[A-Z0-9]+)*$" },
      "title": { "type": "string", "minLength": 1 },
      "organization": { "type": "string", "minLength": 1 },
      "type": { "enum": [
        "standard", "authoritative-guidance", "vendor-docs",
        "corpus", "incident-report", "community"
      ] },
      "tier": { "type": "integer", "minimum": 1, "maximum": 6 },
      "url": { "type": "string", "pattern": "^https://\\S+$" },
      "topics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "license": {
        "type": "string",
        "description": "License of the source material, when relevant to reuse."
      },
      "accessed": { "$ref": "#/$defs/date" },
      "notes": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
